# Copy this file to .env and fill in your values

# MongoDB connection string (free tier: https://www.mongodb.com/cloud/atlas)
# IMPORTANT: in Atlas Network Access, allow connections from anywhere (0.0.0.0/0)
# so that Vercel can reach the database.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret used to sign JWT tokens. Use a long random string.
JWT_SECRET=replace-with-a-strong-secret
